{
  "id": "Holiday",
  "meta": {
    "name": "放假倒计时",
    "version": "1.1",
    "author": "LiteMonitor",
    "description": "显示距离下一个法定节假日还有多少天（含调休计算）；接口无数据或不可用时显示元旦倒计时"
  },
  "inputs": [],
  "execution": {
    "type": "chain",
    "interval": 14400,
    "steps": [
      {
        "id": "fetch_holiday",
        "url": "https://timor.tech/api/holiday/next",
        "method": "GET",
        "response_format": "json",
        "continue_on_error": true,
        "extract": {
          "name": "holiday.name",
          "date": "holiday.date",
          "rest": "holiday.rest"
        }
      },
      {
        "id": "fallback_newyear",
        "url": "native://newyear",
        "skip_if_set": "rest",
        "extract": {
          "name": "name",
          "date": "date",
          "rest": "rest"
        }
      }
    ]
  },
  "outputs": [
    {
      "key": "next",
      "label": "距离{{name}}",
      "short_label": "🏖️",
      "format_val": "{{rest}}",
      "unit": " 天"
    }
  ]
}
